ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_rag_docs
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_rag_docs_test
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenAI-compatible generation client — defaults to Groq's free tier.
# Get a free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Comma-separated — the frontend origin(s) allowed to call this API.
CORS_ALLOW_ORIGINS_RAW=http://localhost:3000
